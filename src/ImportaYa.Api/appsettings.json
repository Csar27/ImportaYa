{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=ImportaYa;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "ImportOptions": {
    "MaxFileSizeBytes": 10485760,
    "MaxRows": 50000,
    "BatchSize": 200,
    "StoragePath": "App_Data/imports"
  },
  "Jwt": {
    "Issuer": "ImportaYa",
    "Audience": "ImportaYa.Client",
    "ExpiresInMinutes": 60
  },
  "AdminSeed": {
    "Email": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://127.0.0.1:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
